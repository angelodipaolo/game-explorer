# Copy to .env and fill in. Never commit .env.

# IGDB access goes through Twitch developer credentials.
# Create an application at https://dev.twitch.tv/console and copy both values.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# SQLite database used by Prisma. Relative to prisma/schema.prisma.
DATABASE_URL="file:./dev.db"
