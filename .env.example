# Copy to .env and fill in. Never commit .env.

# IGDB access goes through Twitch developer credentials.
# Create an application at https://dev.twitch.tv/console and copy both values.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# SQLite database used by Prisma. Relative to prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# --- Hosting (GAMEEXPLOR-0002) ----------------------------------------------
# Set OWNER_PASSWORD and AUTH_SECRET to enforce auth anywhere, including
# locally. With either one missing the server fails closed: nobody can sign in
# and every write is a 401. There is no environment in which leaving them unset
# quietly opens the site — that takes AUTH_OPEN below, on purpose.

# What you type at /login.
#
# On a public URL this is the ONE secret anyone on the internet can sit and
# guess at, and there is no lockout and no app-level rate limit (see
# ops/README.md, which recommends a Cloudflare rate-limit rule as the
# mitigation). So it must be LONG and RANDOM — not a passphrase you invented,
# not a password you use elsewhere. Generate it and put it in your password
# manager, the same way you would an API key:
#
#   openssl rand -base64 24
#
# Stored in plain text on purpose; hashing protects nothing a leaked .env
# (which also holds AUTH_SECRET and every API token) has not already given away.
OWNER_PASSWORD=
# Signs the 30-day session cookie. Any long random string: openssl rand -base64 24
# Rotating it signs out every browser at once — that is how a session is revoked.
AUTH_SECRET=
# Bearer tokens for agents and scripts, comma-separated name:token pairs.
# Delete one pair to revoke that client without touching the others.
API_TOKENS=

# Development/CI only — NEVER set this in production. Enables the no-login open
# mode: with AUTH_OPEN=1 and both variables above unset, everyone is the owner
# and nothing asks for a password, which is what `npm run dev` and the
# Playwright suite want. Both set it themselves (package.json, playwright.config.ts),
# so you do not normally put it here. Nothing else turns open mode on — in
# particular NODE_ENV does not, because `next start` does not set it and a
# production build must never inherit an open site from a stray shell variable.
AUTH_OPEN=

# --- Talking to the API (skills and scripts) --------------------------------
# Where the app is. Unset means http://localhost:3000.
GAME_EXPLORER_URL=
# One of the API_TOKENS values above; every /api/* call needs it.
GAME_EXPLORER_TOKEN=
