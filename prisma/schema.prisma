// Game Explorer data model.
//
// The schema is the architectural seam: the app reads only these tables, and
// exactly one module (src/lib/igdb) talks to IGDB.
//
// Two sides:
//   - What the owner OWNS: OwnedGame (+ GameFact overrides, import batches)
//   - What IGDB KNOWS: CatalogGame, keyed by IGDB id, refreshed by sync

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// A physical game the owner owns. One row per (title, platform); `quantity`
/// counts copies.
model OwnedGame {
  id              String  @id @default(cuid())
  /// Title as written on the shelf / in the source data.
  title           String
  /// Lower-cased, punctuation-stripped title used for dedupe.
  normalizedTitle String
  /// Canonical platform slug, e.g. "nes". See src/lib/platforms.ts.
  platform        String
  quantity        Int     @default(1)
  /// loose | cib | new | box-only | manual-only — free text from source data.
  completeness    String?
  condition       String?
  notes           String?

  /// Link into the catalog. Null when IGDB has no entry (e.g. Roller Games).
  catalogGameId   Int?
  catalogGame     CatalogGame? @relation(fields: [catalogGameId], references: [igdbId], onDelete: SetNull)
  /// 0..1 confidence of the automatic match, null when set by hand.
  matchConfidence Float?
  /// auto | manual | agent
  matchSource     String?

  importBatchId String?
  importBatch   ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  facts         GameFact[]
  tags          GameTag[]
  codes         GameCode[]
  maps          GameMap[]
  bookmarks     GameBookmark[]
  manuals       GameManual[]
  music         MusicTrack[]
  sessions      PlaySession[]
  journal       JournalEntry[]
  queueEntry    QueueEntry?
  importEffects ImportEffect[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([normalizedTitle, platform])
  @@index([platform])
  @@index([catalogGameId])
  @@index([importBatchId])
}

/// A fact about an owned game that overrides or fills in what the catalog
/// says. Precedence when resolving: manual > agent > catalog.
/// `field` is one of the keys in src/lib/facts.ts (e.g. "maxPlayers",
/// "simultaneousPlay", "coop"). `value` is JSON-encoded.
model GameFact {
  id          String    @id @default(cuid())
  ownedGameId String
  ownedGame   OwnedGame @relation(fields: [ownedGameId], references: [id], onDelete: Cascade)
  field       String
  value       String
  /// manual | agent
  source      String
  /// Where an agent found it. Required for agent-sourced facts.
  sourceUrl   String?
  note        String?
  /// Identifies the enrichment run that wrote it, for reporting.
  runId       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([ownedGameId, field])
  @@index([source])
  @@index([runId])
}

/// A tag on an owned game. Layered over IGDB's genres/perspectives/themes:
///   manual    — the owner added it
///   agent     — an enrichment run added it (cite sourceUrl)
///   igdb-hide — hides an IGDB tag for this game without touching the catalog
/// `key` is the normalised form used for matching; `tag` is how it is shown.
model GameTag {
  id          String    @id @default(cuid())
  ownedGameId String
  ownedGame   OwnedGame @relation(fields: [ownedGameId], references: [id], onDelete: Cascade)
  key         String
  tag         String
  source      String
  sourceUrl   String?
  note        String?
  runId       String?
  createdAt   DateTime  @default(now())

  @@unique([ownedGameId, key, source])
  @@index([key])
  @@index([runId])
}

/// A password, cheat, or cheat-device code for one owned copy. Per copy, not
/// per game: Game Genie codes differ by platform.
///
/// Unlike GameFact and GameTag there is no `source` — a code typed in by hand
/// and a code written by a research skill are the same kind of record, written
/// through the same API. Nothing here outranks anything else.
model GameCode {
  id          String    @id @default(cuid())
  ownedGameId String
  ownedGame   OwnedGame @relation(fields: [ownedGameId], references: [id], onDelete: Cascade)
  /// password | cheat | game-genie | action-replay
  kind        String
  /// What it does, in plain words: "Start on level 5", "Infinite lives".
  effect      String
  /// The code itself. Null for cheats where the entry sequence IS the code.
  code        String?
  /// Upper-cased, non-alphanumerics stripped — dedupe key. Falls back to the
  /// normalised `effect` when `code` is null.
  codeKey     String
  /// How to enter it: "At the title screen, press Up Up Down Down…".
  howTo       String?
  /// Where it came from, when whoever added it had a link. Never required.
  sourceUrl   String?
  note        String?
  /// Tried on hardware and it works. Anyone may set it.
  verified    Boolean   @default(false)
  /// Display order within a kind.
  position    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([ownedGameId, kind, codeKey])
  @@index([ownedGameId])
}

/// Cached IGDB metadata. `detail` tells how much was fetched:
///   stub  — id, name, slug, cover only (a similar-game reference)
///   full  — everything below
model CatalogGame {
  igdbId             Int       @id
  name               String
  slug               String
  detail             String    @default("stub")
  summary            String?
  storyline          String?
  firstReleaseDate   DateTime?
  /// IGDB image id for the cover; served from the local cache by src/lib/images/.
  coverImageId       String?
  coverWidth         Int?
  coverHeight        Int?
  rating             Float?
  ratingCount        Int?
  /// JSON string[] of platform names IGDB lists for this game.
  platformNames      String    @default("[]")
  /// JSON number[] of IGDB platform ids.
  platformIds        String    @default("[]")
  /// JSON string[]
  genres             String    @default("[]")
  themes             String    @default("[]")
  playerPerspectives String    @default("[]")
  keywords           String    @default("[]")
  developers         String    @default("[]")
  publishers         String    @default("[]")
  /// JSON number[] — IGDB game_modes ids (1 single, 2 multi, 3 co-op, 4 split screen)
  gameModes          String    @default("[]")
  /// JSON {imageId,width,height}[]
  screenshots        String    @default("[]")
  /// JSON number[] of IGDB ids (each present in this table at least as a stub)
  similarGameIds     String    @default("[]")
  /// JSON number[] — IGDB *collection* ids ("Final Fantasy", "Mario Party").
  /// Plural because a game is in several: Final Fantasy VII is in three. This
  /// is the seed source for a Series, never its membership — see src/lib/series.
  collections        String    @default("[]")
  /// JSON number[] — IGDB franchise ids. Coarser than a collection.
  franchises         String    @default("[]")
  /// IGDB parent_game / version_parent: a port's original, a remake's base. Similar-game
  /// links usually point at the parent, so ownership is matched through it too.
  parentIgdbId       Int?

  // --- multiplayer_modes tier (20% coverage). Null = IGDB has no record. ---
  mpOfflineMax     Int?
  mpOfflineCoopMax Int?
  mpOfflineCoop    Boolean?
  mpSplitscreen    Boolean?
  mpCampaignCoop   Boolean?
  mpDropIn         Boolean?
  mpLanCoop        Boolean?
  mpOnlineCoop     Boolean?
  mpOnlineMax      Int?

  /// Rough length in minutes from IGDB time_to_beat (normally), null when absent.
  ttbNormally   Int?
  ttbHastily    Int?
  ttbCompletely Int?

  fetchedAt  DateTime    @default(now())
  ownedGames OwnedGame[]

  @@index([name])
  @@index([detail])
  @@index([parentIgdbId])
}

/// A staged import: rows submitted by an agent (or a CSV drop), reviewed, then
/// committed as one ImportBatch.
model ImportSession {
  id        String       @id @default(cuid())
  label     String
  /// agent | csv | migration
  source    String       @default("agent")
  /// open | committed | discarded
  status    String       @default("open")
  rows      ImportRow[]
  batch     ImportBatch?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

/// One submitted row and everything the API decided about it.
model ImportRow {
  id               String        @id @default(cuid())
  sessionId        String
  session          ImportSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  /// Position in submission order.
  index            Int
  /// Normalised input as JSON: {title, platform, quantity, completeness, condition, notes, igdbId?}
  input            String
  title            String
  normalizedTitle  String
  platform         String
  quantity         Int           @default(1)
  /// JSON string[] of validation problems; empty means valid.
  problems         String        @default("[]")
  /// none | in-session | existing
  dedupeKind       String        @default("none")
  /// Id of the OwnedGame (existing) or ImportRow (in-session) it collides with.
  dedupeTargetId   String?
  /// JSON MatchCandidate[] ranked by confidence.
  candidates       String        @default("[]")
  /// auto | review | accepted | dropped | merge
  decision         String        @default("review")
  /// Why the API held it: no-match | ambiguous | low-confidence | duplicate | invalid
  holdReason       String?
  chosenIgdbId     Int?
  chosenConfidence Float?
  /// Who settled it: api | user | agent
  decidedBy        String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@unique([sessionId, index])
  @@index([sessionId, decision])
}

/// The unit of undo. Every write a commit makes is recorded as an
/// ImportEffect so rollback removes exactly those changes and nothing else.
model ImportBatch {
  id           String         @id @default(cuid())
  sessionId    String         @unique
  session      ImportSession  @relation(fields: [sessionId], references: [id])
  label        String
  /// committed | rolled_back
  status       String         @default("committed")
  ownedGames   OwnedGame[]
  effects      ImportEffect[]
  committedAt  DateTime       @default(now())
  rolledBackAt DateTime?
}

model ImportEffect {
  id          String      @id @default(cuid())
  batchId     String
  batch       ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  /// created | quantity
  kind        String
  ownedGameId String
  ownedGame   OwnedGame   @relation(fields: [ownedGameId], references: [id], onDelete: Cascade)
  /// For quantity effects: how much was added (reversed on rollback).
  delta       Int?

  @@index([batchId])
}

/// A batch enrichment run by an agent, for reporting what changed.
model EnrichmentRun {
  id         String    @id @default(cuid())
  label      String?
  /// JSON summary written at the end: {written, skipped, conflicts}
  summary    String?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
}

/// One map image for an owned copy — an overworld, a dungeon floor, a level
/// select — plus the markers placed on it. Coordinates are pixels of the
/// stored image, so the same rows render at any zoom.
///
/// Like GameCode there is no `source` and no precedence: a map placed by hand
/// and one written by a research skill are the same record.
///
/// The image bytes live on disk under data/maps/<id>.png (private, gitignored,
/// not in the snapshot) and are served by /api/maps/:id/image.
model GameMap {
  id          String      @id @default(cuid())
  ownedGameId String
  ownedGame   OwnedGame   @relation(fields: [ownedGameId], references: [id], onDelete: Cascade)
  /// URL-safe handle unique per game: "overworld", "underworld", "moon".
  slug        String
  title       String
  subtitle    String?
  /// Pixel size of the stored image; 0 until an image is uploaded.
  width       Int         @default(0)
  height      Int         @default(0)
  /// Where the image came from, when whoever added it had a link.
  sourceUrl   String?
  note        String?
  /// Display order among a game's maps.
  position    Int         @default(0)
  markers     MapMarker[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([ownedGameId, slug])
  @@index([ownedGameId])
}

/// A point of interest on a GameMap, in image pixels.
model MapMarker {
  id        String   @id @default(cuid())
  mapId     String
  map       GameMap  @relation(fields: [mapId], references: [id], onDelete: Cascade)
  name      String
  /// town | castle | dungeon | cave | shop | boss | item | secret | travel | other
  kind      String   @default("other")
  x         Int
  y         Int
  /// One line: what you do or find there.
  note      String?
  sourceUrl String?
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([mapId, name])
  @@index([mapId])
}

/// A link worth keeping for one owned copy: the GameFAQs guide, the wiki page,
/// the longplay. `why` is the one line that says what makes this link the one
/// to open — a list of bare URLs is a bookmarks folder nobody reads.
///
/// Same stance as GameCode and GameMap: no `source` and no precedence. A link
/// the owner pasted and a link a research skill found are the same record, and
/// the bookmark *is* its own citation — the URL is the source.
model GameBookmark {
  id          String    @id @default(cuid())
  ownedGameId String
  ownedGame   OwnedGame @relation(fields: [ownedGameId], references: [id], onDelete: Cascade)
  /// guide | article | video | wiki | longplay
  kind        String
  url         String
  /// Lower-cased URL with the scheme, "www.", trailing slash and tracking
  /// query thrown away — the dedupe key, so the same page saved twice is one row.
  urlKey      String
  /// What the page calls itself: "Contra — FAQ/Walkthrough by CyricZ".
  title       String
  /// One line: why this one and not the other nine hits.
  why         String
  note        String?
  /// Display order within a kind.
  position    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([ownedGameId, urlKey])
  @@index([ownedGameId])
}

/// A scanned manual for one owned copy: an ordered set of page images.
/// Mechanically GameMap with pages instead of markers — the pixels live on
/// disk under data/manuals/<ManualPage id>.<ext> (private, gitignored, **not**
/// in db:snapshot) and are served by /api/manual-pages/:id/image.
///
/// No `source`, no precedence, like GameCode and GameMap.
model GameManual {
  id          String       @id @default(cuid())
  ownedGameId String
  ownedGame   OwnedGame    @relation(fields: [ownedGameId], references: [id], onDelete: Cascade)
  /// "Manual" for the usual case; "Poster map", "Nintendo Power insert" otherwise.
  title       String       @default("Manual")
  /// Where the scan came from, when whoever added it had a link.
  sourceUrl   String?
  note        String?
  /// Display order among a game's manuals.
  position    Int          @default(0)
  pages       ManualPage[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([ownedGameId])
}

/// One soundtrack track for an owned copy (GAMEEXPLOR-0025): a row here, the
/// audio itself on disk under data/music/<id>.mp3, served by
/// /api/music/:trackId/audio.
///
/// Keyed on the owned copy, cascading on delete, exactly like GameMap and
/// GameManual — and deliberately not on the catalog game: the NES and the SNES
/// version of a title have genuinely different soundtracks, and every other
/// blob domain in this app already hangs off the copy.
///
/// No `position`: the player picks a track at random, so there is no order to
/// keep. No `source` and no precedence either — a track a skill registered and
/// a track the owner added are one kind of row, the same stance codes, maps,
/// bookmarks and manuals take.
model MusicTrack {
  id          String    @id @default(cuid())
  ownedGameId String
  ownedGame   OwnedGame @relation(fields: [ownedGameId], references: [id], onDelete: Cascade)
  /// The piece as a human reads it: "Vampire Killer", not a filename.
  title       String
  /// Sniffed from the uploaded bytes. "audio/mpeg" is the only value today.
  contentType String    @default("audio/mpeg")
  /// Size of the stored file; 0 until the audio has been uploaded, which is a
  /// real state — the row is created first and the bytes are PUT after.
  bytes       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([ownedGameId])
}

/// One page of a scanned manual. `position` is dense 0..n-1 and renumbered on
/// every insert, reorder and delete, so "page 4 of 12" is always true.
model ManualPage {
  id        String     @id @default(cuid())
  manualId  String
  manual    GameManual @relation(fields: [manualId], references: [id], onDelete: Cascade)
  /// Dense 0..n-1. Page 1 is position 0.
  position  Int
  /// What this page is, when it is worth saying: "Controls", "Enemy list".
  label     String?
  /// Pixel size of the stored image; 0 until one is uploaded.
  width     Int        @default(0)
  height    Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([manualId, position])
}

/// One run at one owned copy. The log, not a status: a game played every few
/// years has several of these, each with its own dates and its own journal.
/// `endedAt` null is the only definition of "playing now" — there is no status
/// column on OwnedGame and there must never be one.
model PlaySession {
  id          String         @id @default(cuid())
  ownedGameId String
  ownedGame   OwnedGame      @relation(fields: [ownedGameId], references: [id], onDelete: Cascade)
  startedAt   DateTime
  /// Null while the run is open.
  endedAt     DateTime?
  /// playing | completed | abandoned. Constrained against endedAt in the
  /// service: open runs are always "playing", ended runs never are.
  outcome     String         @default("playing")
  /// True when the owner does not know when this run happened. `startedAt`
  /// and `endedAt` then hold the moment it was recorded, purely as
  /// placeholders so that `endedAt is null` stays the one definition of
  /// "playing now" — the UI never shows them, and they never count towards
  /// `lastPlayedAt`. Only a finished run can be undated.
  undated     Boolean        @default(false)
  /// One line: "stuck on world 5", "second playthrough, hard mode".
  note        String?
  entries     JournalEntry[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([ownedGameId, startedAt])
  @@index([endedAt])
}

/// A dated note or photo about one owned copy. `sessionId` ties it to a run
/// when there is one, so notes written during the 2026 playthrough stay with
/// the 2026 playthrough after a 2029 replay. Deleting a run nulls the link
/// rather than destroying the writing.
///
/// Like GameCode and GameMap there is no `source` and no precedence — but
/// unlike them there is no agent write path at all. Only the owner writes here.
model JournalEntry {
  id          String       @id @default(cuid())
  ownedGameId String
  ownedGame   OwnedGame    @relation(fields: [ownedGameId], references: [id], onDelete: Cascade)
  sessionId   String?
  session     PlaySession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  /// note | photo
  kind        String
  /// Optional for both kinds: a photo's caption, a note's heading.
  title       String?
  /// The writing. Null for a bare photo.
  body        String?
  /// When it happened — defaults to now, editable so a memory can be backdated.
  occurredAt  DateTime
  /// Pixel size of the stored image; 0 until one is uploaded. Photos only.
  width       Int          @default(0)
  height      Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([ownedGameId, occurredAt])
  @@index([sessionId])
}

/// The one ordered "up next" list. `ownedGameId` is unique — a game is queued
/// at most once — and there is deliberately no `name`/`list` column, because
/// one queue is a decision about what to play next and several named lists are
/// a filing system. Kept disjoint from open runs by the service: starting a
/// run removes the game from here, and a game with an open run cannot be added.
model QueueEntry {
  id          String    @id @default(cuid())
  ownedGameId String    @unique
  ownedGame   OwnedGame @relation(fields: [ownedGameId], references: [id], onDelete: Cascade)
  /// Dense 0..n-1, renumbered on every reorder.
  position    Int
  /// "after I finish FF7", "borrowed — play it before giving it back".
  note        String?
  addedAt     DateTime  @default(now())

  @@index([position])
}

/// A named, ordered list of *catalog* games — every Final Fantasy, every Mario
/// Party. Membership is by IGDB id, not by owned copy: ownership is resolved at
/// render time (the same way matchSimilarToOwned does for the similar strip),
/// so a series page answers "what am I missing" rather than being a saved
/// shelf filter.
///
/// Same stance as GameCode, GameMap and GameBookmark: no `source` column and no
/// precedence. A series is a public fact about games, so the owner and a
/// research skill write through one API and neither outranks the other.
model Series {
  id           String  @id @default(cuid())
  name         String
  /// URL handle — /series/<slug>.
  slug         String  @unique
  /// One line. Agents source and cite; they do not author prose.
  blurb        String?
  /// Cover override: an IGDB image id. Normally null — the card derives its
  /// cover from the first entry that has art. There is no upload path.
  coverImageId String?
  /// Order on /series; ties break on name.
  position     Int     @default(0)

  /// The IGDB collection this was seeded from, so "check for new entries" can
  /// diff it later. Null when the series was typed by hand.
  seedCollectionId Int?
  /// JSON number[] — every IGDB id a seed or a check has already SHOWN the
  /// owner, whether it was kept or unticked. "New since the last prune" is
  /// `collection.games[] − (seenIgdbIds ∪ current entry ids)`, so a game that
  /// was deliberately dropped never comes back as new, while one added by hand
  /// (and therefore never "seen") is still not reported as new.
  seenIgdbIds      String    @default("[]")
  /// When the seed collection was last diffed, for the "checked …" line.
  seedCheckedAt    DateTime?

  entries   SeriesEntry[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([position])
}

/// One place in a series. Either an `igdbId` — the normal case, where the
/// CatalogGame row (full or stub) supplies the cover and the name whether the
/// game is owned or not — or a free-text `title` when IGDB has no entry at all,
/// the same tolerance OwnedGame.catalogGameId being null gives a game like
/// Roller Games.
///
/// Many-to-many on purpose: a game belongs to several series (Super Mario Party
/// is in Mario Party and arguably Mario), so there is NO unique constraint on
/// igdbId across series — only one per series.
model SeriesEntry {
  id        String   @id @default(cuid())
  seriesId  String
  series    Series   @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  /// The catalog game. Null only when `title` carries the name instead.
  igdbId    Int?
  /// Free text when igdbId is null; an override label when it is set.
  title     String?
  /// Dense 0..n-1 within the series, renumbered on every insert, reorder and
  /// remove, so the order the owner curated is exactly what renders.
  position  Int
  /// "Mainline", "Spin-offs", "Remakes". Null groups under no heading.
  section   String?
  note      String?
  sourceUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One entry per game per series. SQLite treats NULLs as distinct, so any
  /// number of free-text entries can sit alongside them.
  @@unique([seriesId, igdbId])
  @@index([seriesId, position])
}
